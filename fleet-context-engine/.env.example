# Copy to .env and fill in (cp .env.example .env). .env is gitignored -
# never commit it. See setup-demo.md/SETUP.md for where each value comes
# from (`terraform output -raw <name>` in terraform/).

# --- Confluent Cloud: required for LIVE mode (Kafka consumer). Leave all
# eight unset to run in SIMULATED mode instead (no Confluent Cloud needed). ---
KAFKA_BOOTSTRAP_ENDPOINT=
KAFKA_REST_ENDPOINT=
KAFKA_CLUSTER_ID=
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_ENDPOINT=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# --- RTCE: required only for the /api/ask natural-language endpoint.
# RTCE_API_KEY/SECRET must be a Global-scoped Confluent Cloud API key - see
# SETUP.md section 3. ---
RTCE_URL=
RTCE_API_KEY=
RTCE_API_SECRET=

# --- OpenAI: required only for /api/ask (the NL query agent's own model
# call - separate from the OpenAI connection Flink uses, see terraform/flink.tf). ---
OPENAI_API_KEY=
# OPENAI_NL_MODEL=gpt-4o-mini

# --- Local server port. Cloud Run sets PORT itself; leave unset locally to
# use the 8787 default. ---
# HTTP_PORT=8787
